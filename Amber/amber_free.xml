<mujoco model="amber3_PF">
  <option iterations="50" timestep="0.001" solver="PGS" gravity="0 0 -9.81" />

  <compiler angle="radian" meshdir="meshes" eulerseq="zyx" autolimits="true" />

  <default>
    <joint limited="true" damping="0.01" armature="0.01" frictionloss="0.01" />
    <geom condim="4" contype="1" conaffinity="15" friction="0.9 0.2 0.2" solref="0.001 2" />
    <motor ctrllimited="true" />
    <equality solref="0.001 2" />
    <default class="visualgeom">
      <geom material="visualgeom" condim="1" contype="0" conaffinity="0" />
    </default>
  </default>

  <worldbody>
    <light directional="true" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1" pos="0 0 5.0" dir="0 0 -1" castshadow="false" />
    <light directional="true" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2" pos="0 0 4" dir="0 0 -1" />
    <geom name="ground" type="plane" pos="0 0 0" size="100 100 0.001" quat="1 0 0 0" material="matplane" condim="3" conaffinity="15" />
    <camera name="fixed" pos="0 -3.0 1.8699" xyaxes="1 0 0 0 0 1" />
    <camera name="track" mode="trackcom" pos="0 -3.0 1.8699" xyaxes="1 0 0 0 0 1" />
    <body name="root" pos="0 0 1.3699" quat="1 0 0 0">
      <freejoint name="root" />
      <site name="imu" size="0.01" pos="0 0 0" />
      <body name="left_thigh" pos="0 0 -0.4999">
        <inertial pos="0 0 -0.1494" quat="0 0.707107 0 0.707107" mass="3.4261" diaginertia="0.04 0.0389 0.02" />
        <joint name="q1_left" pos="0 0 0" axis="0 1 0" range="-1.6 1.6" actuatorfrcrange="-400 400" />
        <body name="left_shin" pos="0 0 -0.4064">
          <inertial pos="0.0260381 0.120712 -0.127129" quat="0.502086 0.646617 -0.525745 0.231059" mass="1.15216" diaginertia="0.069516 0.0675867 0.0187097" />
          <joint name="q2_left" pos="0 0 0" axis="0 1 0" range="0 1.5" actuatorfrcrange="-400 400" />
          <geom size="0.003" pos="0 -0.1 -0.4636" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
          <geom type="" rgba="" pos="0 -0.1 -0.4636" />
        </body>
      </body>
      <body name="right_thigh" pos="0 0 -0.4999">
        <inertial pos="0 0 -0.1494" quat="0.707107 0 0 0.707107" mass="3.4261" diaginertia="0.0389 0.03 0.03" />
        <joint name="q1_right" pos="0 0 0" axis="0 1 0" range="-1.6 1.6" actuatorfrcrange="-400 400" />
        <body name="right_shin" pos="0 0 -0.4064">
          <inertial pos="-0.0260381 0 -0.247842" quat="0.697489 0.11623 0.11623 0.697489" mass="1.15216" diaginertia="0.0418868 0.0321008 0.011" />
          <joint name="q2_right" pos="0 0 0" axis="0 1 0" range="0 1.5" actuatorfrcrange="-400 400" />
          <geom size="0.003" pos="0 0.1 -0.4636" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
          <geom type="" rgba="" pos="0 0.1 -0.4636" />
        </body>
      </body>
    </body>
  </worldbody>

  <asset>
    <texture name="texplane" type="2d" builtin="checker" rgb1=".0 .0 .0" rgb2=".8 .8 .8" width="100" height="100" />
    <material name="matplane" reflectance="0." texture="texplane" texrepeat="1 1" texuniform="true" />
    <material name="visualgeom" rgba="0.5 0.9 0.2 1" />
  </asset>

  <actuator>
    <motor name="q1_left" joint="q1_left" ctrllimited="true" ctrlrange="-400 400" gear="1" />
    <motor name="q2_left" joint="q2_left" ctrllimited="true" ctrlrange="-400 400" gear="1" />
    <motor name="q1_right" joint="q1_right" ctrllimited="true" ctrlrange="-400 400" gear="1" />
    <motor name="q2_right" joint="q2_right" ctrllimited="true" ctrlrange="-400 400" gear="1" />
  </actuator>

  <sensor>
    <actuatorpos name="q1_left_p" actuator="q1_left" />
    <actuatorvel name="q1_left_v" actuator="q1_left" />
    <actuatorfrc name="q1_left_f" actuator="q1_left" noise="0.001" />
    <actuatorpos name="q2_left_p" actuator="q2_left" />
    <actuatorvel name="q2_left_v" actuator="q2_left" />
    <actuatorfrc name="q2_left_f" actuator="q2_left" noise="0.001" />
    <actuatorpos name="q1_right_p" actuator="q1_right" />
    <actuatorvel name="q1_right_v" actuator="q1_right" />
    <actuatorfrc name="q1_right_f" actuator="q1_right" noise="0.001" />
    <actuatorpos name="q2_right_p" actuator="q2_right" />
    <actuatorvel name="q2_right_v" actuator="q2_right" />
    <actuatorfrc name="q2_right_f" actuator="q2_right" noise="0.001" />
    <framequat name="orientation" objtype="site" noise="0.001" objname="imu" />
    <gyro name="angular-velocity" site="imu" noise="0.005" cutoff="34.9" />
  </sensor>
</mujoco>